# Generated by porting/scripts/gen-fedora-packaging.py from debian/ (regolith-control-center). Do not edit by hand;
# fix the generator or porting/fedora/repos.json instead.
# Track B usage (from the repo root):  make -f fedora/Makefile && sudo make -f fedora/Makefile install
# RPM usage: the spec runs the same targets with DESTDIR=%{buildroot}.

DESTDIR ?=
PREFIX ?= /usr
LIBDIR ?= $(PREFIX)/lib64
SYSCONFDIR ?= /etc
BUILDDIR ?= _fedora_build
INSTALL ?= install
CP ?= cp -a --no-preserve=ownership
PYTHON ?= python3
MESON_FLAGS ?= --buildtype=release

# Don't leak our variables into upstream sub-makes: command-line vars travel via MAKEFLAGS (MAKEOVERRIDES)
# *and* the environment (unexport). Upstream Makefiles like xrescat use `PREFIX ?= $(DESTDIR)` (BRE-010).
MAKEOVERRIDES :=
unexport PREFIX LIBDIR SYSCONFDIR BUILDDIR INSTALL CP PYTHON MESON_FLAGS

.PHONY: all build install patch
all: build

# Debian quilt series (debian/patches/series) applied once; stamp file prevents double application
patch: .fedora-patched
.fedora-patched:
	patch -p1 --forward --no-backup-if-mismatch < debian/patches/kbd-lvl3.patch
	patch -p1 --forward --no-backup-if-mismatch < debian/patches/debian/Ignore-result-of-test-network-panel.patch
	patch -p1 --forward --no-backup-if-mismatch < debian/patches/ubuntu/keyboard-Add-launch-terminal-shortcut.patch
	patch -p1 --forward --no-backup-if-mismatch < debian/patches/ubuntu/sound-Allow-volume-to-be-set-above-100.patch
	patch -p1 --forward --no-backup-if-mismatch < debian/patches/ubuntu/online-accounts-Hide-window-after-adding-an-online-accoun.patch
	patch -p1 --forward --no-backup-if-mismatch < debian/patches/ubuntu/online-accounts-sort.patch
	patch -p1 --forward --no-backup-if-mismatch < debian/patches/ubuntu/display-Allow-fractional-scaling-to-be-enabled.patch
	patch -p1 --forward --no-backup-if-mismatch < debian/patches/ubuntu/CVE-2023-5616.patch
	patch -p1 --forward --no-backup-if-mismatch < debian/patches/ubuntu/remove-donate.patch
	touch $@

build: .fedora-patched
	test -f $(BUILDDIR)/build.ninja || meson setup $(BUILDDIR) --prefix=$(PREFIX) --libdir=$(LIBDIR) --sysconfdir=$(SYSCONFDIR) $(MESON_FLAGS) -Dprivileged_group=wheel -Ddocumentation=false -Dmalcontent=true
	meson compile -C $(BUILDDIR)

.PHONY: check
check:
	@echo 'no upstream tests'

.PHONY: install-stage
install-stage:
	rm -rf "$(CURDIR)/_fedora_stage"
	meson install -C $(BUILDDIR) --destdir "$(CURDIR)/_fedora_stage" --no-rebuild

.PHONY: install-regolith-control-center
install-regolith-control-center: install-stage
	$(INSTALL) -d "$(DESTDIR)/" && $(CP) "$(CURDIR)/_fedora_stage/." "$(DESTDIR)/"
	@$(MAKE) -f fedora/Makefile post-install

.PHONY: install post-install
install: install-regolith-control-center

post-install:
	@if [ -z "$(DESTDIR)" ]; then \
	  glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true; \
	  for d in /usr/share/icons/*/; do [ -f "$$d/index.theme" ] && gtk-update-icon-cache -q -f "$$d" || true; done; \
	  command -v fc-cache >/dev/null && fc-cache -s >/dev/null 2>&1 || true; \
	  update-desktop-database -q /usr/share/applications 2>/dev/null || true; \
	fi

