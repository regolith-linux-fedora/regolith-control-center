%description
This package contains configuration applets for the Regolith desktop,
allowing to set accessibility configuration, desktop fonts, keyboard
and mouse properties, sound setup, desktop theme and background, user
interface properties, screen resolution, and other GNOME parameters.

It also contains a front end to these applets, which can also be
accessed with the GNOME panel or the Nautilus file manager.

%prep
%autosetup -n %{name}-%{version}
# apply debian/patches/series (Fedora exclusions from repos.json)
%make_build -f fedora/Makefile patch

%build
%set_build_flags
%make_build -f fedora/Makefile build MESON_FLAGS="--buildtype=plain"

%install
%make_install -f fedora/Makefile PREFIX=%{_prefix} LIBDIR=%{_libdir} SYSCONFDIR=%{_sysconfdir}
# single-binary compiled package: own everything the build installed
(cd %{buildroot} && find . \( -type f -o -type l \) | sed 's|^\.||' \
   | sed -E 's|^(/usr/lib/python3[^/]*/site-packages/[^/]+)/.*|\1|; s|^(/usr/share/man/.*)$|\1*|' \
   | sort -u | sed -E 's|^(/etc/.*)$|%config(noreplace) \1|') > regolith-control-center.files

%files -f regolith-control-center.files

